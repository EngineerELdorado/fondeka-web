# Run a local, isolated demo. Set false to connect to the Fondeka backend.
NEXT_PUBLIC_DEMO_MODE=true

# Enable only after the backend contract, pricing and grandfathering are ready.
# Backend BUSINESS_TOOLS_ACCESS_REQUIRED denials are always handled centrally.
NEXT_PUBLIC_BUSINESS_TOOLS_ENABLED=false

# Server-only; never expose an API key or a client secret here.
FONDEKA_API_BASE_URL=http://localhost:8080

# Public identifiers for a Cognito app client with no client secret.
# Reuse the mobile app's EXPO_PUBLIC_USER_POOL_ID and
# EXPO_PUBLIC_COGNITO_APP_CLIENT_ID, respectively.
# These identify the same customer account used in the mobile app.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# Optional HTTPS media public base, matching backend MEDIA_PUBLIC_BASE configuration.
# Restricts managed-video cleanup to this origin and path when set.
NEXT_PUBLIC_MEDIA_BASE_URL=
